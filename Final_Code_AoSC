import numpy as np
import matplotlib.pyplot as plt
import math
from scipy.linalg import eigh
from scipy.spatial import cKDTree
import pyvista as pv
from pathlib import Path

####################################################################################################
'''generare positions of atoms in graphene'''

def generate_graphene_shell(n_sites, a_cc=1.42):
    """ Generates a finite graphene structure by adding 
    benzene rings shell-by-shell around a central benzene ring. 
    """ 

    # 1. Geometry - translations vectors between centres of neighbouring hexagonal rings

    t1 = np.array([3 * a_cc / 2, np.sqrt(3) * a_cc / 2]) 
    t2 = np.array([3 * a_cc / 2, -np.sqrt(3) * a_cc / 2]) 


    # 2. Generate one benzene ring 
    
    def make_ring(i, j): 

        centre = i * t1 + j * t2 
        ring = [] 

        for k in range(6): 

            theta = k * np.pi / 3 

            position = centre + a_cc * np.array([ np.cos(theta), 
                                                  np.sin(theta) ]) 
            
            ring.append(position) 

        return ring 
    

    # 3. Store unique carbon atoms (remove duplicates in lattice)

    lattice = [] 

    def add_ring(i, j): 

        ring = make_ring(i, j) 
        add_atoms = [] 

        for new_atom in ring: 

            already_exists = False 

            for atom in lattice: 

                if np.linalg.norm(new_atom - atom) < 1e-6: 
                    already_exists = True 
                    break 

            if already_exists == False: 
                add_atoms.append(new_atom) 

        return add_atoms 
    

    # 4. Generate the structure shell-by-shell 
    
    shell = 0

    while len(lattice) < n_sites:
        # Find all rings belonging to this shell
        shell_rings = []

        for i in range(-shell, shell + 1):
            for j in range(-shell, shell + 1):
                if max(abs(i), abs(j), abs(i + j)) == shell:
                    
                    shell_rings.append((i, j))

        # Process each ring in this shell
        for i, j in shell_rings:

            add_atoms = add_ring(i, j)

            if len(lattice) + len(add_atoms) <= n_sites:
                lattice.extend(add_atoms)                  

            else:
                # Add remaining atoms (incomplete ring)
                remaining = n_sites - len(lattice)

                def distance_to_structure(new_atom):
                    return min(np.linalg.norm(new_atom - atom) for atom in lattice)

                if len(lattice) == 0:
                    # first ring
                    add_atoms = add_atoms[:remaining]
                else:
                    # add remaining closest to structure, within same ring 
                    add_atoms.sort(key=lambda p: (distance_to_structure(p), np.linalg.norm(p)))    #Please note I used Chatgpt for this if/else statement
                    add_atoms = add_atoms[:remaining]

                lattice.extend(add_atoms)
                return np.array(lattice)

        shell += 1

    return np.array(lattice[:n_sites])

#----------------------------------------------------------------------
'''# Find pairs of carbon atoms separated by one C-C bond '''

def find_bonds(positions, a_cc=1.42, tolerance=0.1):
    '''Return index pairs (i,j) of nearest neighbours, with i<j.'''
    # I used chatgpt as my original method was computationally expensive
    pairs = cKDTree(positions).query_pairs(r=a_cc + tolerance)
    return sorted(
        (i, j) for i, j in pairs
        if abs(np.linalg.norm(positions[i] - positions[j]) - a_cc) < tolerance
    )

#----------------------------------------------------------------------
'''Slater Function'''

def slater(l, lam, r, y):

    norm = np.sqrt(((2*lam)**(2*l+3))/(math.factorial(2*l+2)))
    f = norm * r**l * np.exp(-lam*r) * y

    return f

#----------------------------------------------------------------------
'''Huckel Hamiltonian matrix'''

def H_graphene(n_sites, positions, alpha=0.0, beta=-1.0, a_cc=1.42, tolerance=0.1):
    '''Build real symmetric nearest neighbour π-electron Hamiltonian.'''

    H = alpha * np.eye(n_sites) 

    bonds = find_bonds(positions, a_cc, tolerance)

    for i, j in bonds:
        H[i, j] = beta
        H[j, i] = beta

    return H

#----------------------------------------------------------------------
'''Solve for positions, solve eigenvalues and eigenvectors of H matrix'''

def solve_huckel(n_sites, alpha=0.0, beta=-1.0, a_cc=1.42, tolerance=0.1):
    '''Generate a flake and solve its Hückel eigenvalue problem.'''

    positions = generate_graphene_shell(n_sites)
    e_val, e_vec = np.linalg.eigh(H_graphene(n_sites, positions, alpha, beta, a_cc, tolerance))

    return positions, e_val, e_vec

#----------------------------------------------------------------------
'''Create grid'''

def mesh(grid_points = 40):
    '''Return (X, Y, Z, x, y, z) for a 3D Cartesian grid.'''

    x = np.linspace(-5, 5, grid_points)
    y = np.linspace(-5, 5, grid_points)
    z = np.linspace(-5, 5, grid_points)
    X, Y, Z = np.meshgrid(x, y, z, indexing='ij')

    return X, Y, Z, x, y, z

#----------------------------------------------------------------------
'''Construct isosurface orbitals'''

def orbitals(n_sites, positions, e_vec, l, lam = 1.5):
    '''Construct all molecular orbitals and their PyVista isosurfaces.'''

    X, Y, Z, x, y, z = mesh()

    dx = x[:, None, None, None] - positions[None, None, None, :, 0]          #Thanks to Marcy for her help with this code
    dy = y[None, :, None, None] - positions[None, None, None, :, 1]
    dz = z[None, None, :, None]

    r = np.sqrt(dx**2 + dy**2 + dz**2)

    angular = np.zeros_like(r)
    np.divide( dz, r, out=angular, where=(r != 0) )
    angular *= 0.5 * np.sqrt(3 / np.pi)

    f = slater(l, lam, r, angular)

    MOs = np.einsum('ijkn,no->ijko', f, e_vec)

    grid = []
    iso = []
    surface_pos = []
    surface_neg = []

    # Create PyVista structured grid
    for i in range(n_sites):
        grid_i = pv.StructuredGrid()
        grid_i.points = np.c_[X.ravel(), Y.ravel(), Z.ravel()]
        grid_i.dimensions = MOs[:,:,:,i].shape
        grid_i["psi"] = MOs[:,:,:,i].ravel() 

        grid.append(grid_i)

        iso_i = 0.2 * np.max(np.abs(MOs[:, :, :, i]))
        iso.append(iso_i)

        surface_pos.append(grid_i.contour([iso_i]))
        surface_neg.append(grid_i.contour([-iso_i]))

    return surface_pos, surface_neg, MOs

#----------------------------------------------------------------------
'''Add lattice to orbitals'''

def add_lattice_to_plotter(plotter, positions, a_cc=1.42, tolerance=0.1,
                           atom_radius=0.18, bond_radius=0.06):
    '''Overlay grey carbon-carbon tubes and black atom spheres in z=0'''

    # 1. Convert 2D atomic positions into 3D points
    points_3d = np.column_stack([positions[:, 0], positions[:, 1], np.zeros(len(positions))])


    # 2. Add atoms as spheres
    atom_cloud = pv.PolyData(points_3d)

    sphere = pv.Sphere(radius=atom_radius)

    atom_glyphs = atom_cloud.glyph(
        scale=False,
        orient=False,
        geom=sphere
    )

    plotter.add_mesh(atom_glyphs, color="black", smooth_shading=True)


    # 3. Add bonds as tubes
    bonds = find_bonds(positions, a_cc, tolerance)

    for i, j in bonds:
        p1 = points_3d[i]
        p2 = points_3d[j]

        bond_line = pv.Line(p1, p2)
        bond_tube = bond_line.tube(radius=bond_radius)

        plotter.add_mesh(bond_tube, color="grey", smooth_shading=True)

#----------------------------------------------------------------------
'''Homo, Lumo and gap energies'''

def homo_lumo_gap(e_val):

    e_val = np.sort(e_val)

    n_electrons = len(e_val)

    homo = e_val[n_electrons // 2 - 1]
    lumo = e_val[n_electrons // 2]
    gap = lumo - homo

    return homo, lumo, gap

#----------------------------------------------------------------------
'''Gaps for given shell size'''

def calculate_gaps(n_values, alpha=0.0, beta=-1.0, a_cc=1.42,
                   tolerance=0.1, beta_eV=2.40):
    """Return {N: central eigenvalue separation (eV)} for even N."""
    #Used chatgpt to optimise code

    gaps = {}
    for n in n_values:
        if n < 2 or n % 2:
            continue
        positions = generate_graphene_shell(n, a_cc=a_cc)
        H = H_graphene(n, positions, alpha, beta, a_cc, tolerance)
        middle = eigh(H, eigvals_only=True,
                      subset_by_index=(n // 2 - 1, n // 2),
                      driver='evr', check_finite=False)
        gaps[n] = float(max(0.0, middle[1] - middle[0]) / abs(beta) * beta_eV)
    return gaps

####################################################################################################
'''Plot positions of atoms'''

def plot_positions(n_sites, positions, output_dir):
    '''Save an xy atomic-position diagram with nearest-neighbour bonds.'''

    plt.figure(figsize=(6, 6))

    if n_sites<100:
        size = 100
    else:
        size = 10

    plt.scatter( positions[:, 0], positions[:, 1], s=size)
    bonds = find_bonds(positions)

    for i, j in bonds:

        plt.plot(
            [positions[i, 0], positions[j, 0]],
            [positions[i, 1], positions[j, 1]],
            color="grey",
            linewidth=1.5
        )

    plt.axis("equal")
    plt.xlabel("x")
    plt.ylabel("y")
    plt.title(f"Graphene lattice: {n_sites} sites")
    plt.savefig(output_dir / f"{n_sites}_positions.png")

#----------------------------------------------------------------------
'''3D orbital plot, each axis perspective for all orbitals'''

def plot_3d_orbitals_all(n_sites, positions, surface_pos, surface_neg, output_dir):
    '''Save a (N rows) × (three camera directions) PyVista orbital gallery.'''

    try:
        import pyvista as pv
    except ImportError as exc:
        raise ImportError('Install PyVista to use MO isosurfaces') from exc
    
    plotter = pv.Plotter(shape=(n_sites, 3))

    views = [
        lambda: plotter.view_yz(),
        lambda: plotter.view_zx(),
        lambda: plotter.view_xy()
    ]
    label = ["x", "y", "z"]

    for i in range(n_sites):
        for j in range(3):

            plotter.subplot(i, j)

            #add orbitals
            plotter.add_mesh(surface_pos[i], color="red", opacity=0.8)
            plotter.add_mesh(surface_neg[i], color="blue", opacity=0.8)

            # Add atoms and bonds
            add_lattice_to_plotter(plotter, positions)

            if i == 0:
                plotter.add_text(label[j], position="upper_right")

            plotter.add_text(f"{i+1}")
            views[j]()

    plotter.save_graphic(output_dir /f"{n_sites}_MOs.svg")
    plotter.show()

