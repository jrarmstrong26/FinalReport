'''3D orbital plot, individual orbital of choice'''

def plot_3d_orbital(n_sites, orb_index, positions, surface_pos, surface_neg, output_dir):
    '''Save one 3D MO with the underlying atomic lattice and carbon bonds.'''
    
    try:
        import pyvista as pv
    except ImportError as exc:
        raise ImportError('Install PyVista to use MO isosurfaces') from exc

    if not isinstance(orb_index, (int, np.integer)) or not (1 <= orb_index <= n_sites):   #found scaffolding on stack exchange
        print(f"Invalid orbital index: {orb_index}")
        print(f"Please choose an integer between 1 and {n_sites}.")
        return

    i = orb_index - 1

    plotter = pv.Plotter()

    #add atoms and bonds
    add_lattice_to_plotter(plotter, positions)

    #add orbitals
    plotter.add_mesh(surface_pos[i], color="red", opacity=0.8)
    plotter.add_mesh(surface_neg[i], color="blue", opacity=0.8)

    plotter.add_text(f"{orb_index}")

    plotter.save_graphic(output_dir /f"{orb_index}_MO_individual.svg")
    plotter.show()

#----------------------------------------------------------------------
'''Contour MOs'''

def plot_contour_MO(n_sites, MOs, output_dir):
    '''Save batches of three orthogonal 2D cross sections for all N orbitals.'''

    X, Y, Z, x, y, z = mesh()

    ix = np.argmin(np.abs(x - 0.0))
    iy = np.argmin(np.abs(y - 0.0))
    iz = np.argmin(np.abs(z - 0.0))   #Choose z = 1 as if z=0, all the orbitals look the same 

    orbitals_per_figure = 4
    for start in range(0, n_sites, orbitals_per_figure):

        # Select the next four molecular orbitals
        selected = range(start, min(start + orbitals_per_figure, n_sites))

        fig, axes = plt.subplots(
            len(selected), 3,
            figsize=(13, 3.5 * len(selected)),
            squeeze=False,
            constrained_layout=True
        )

        for row, n in enumerate(selected):

            # Extract three 2D slices of MO n
            slices = [
                (Y[ix, :, :], Z[ix, :, :],
                 MOs[ix, :, :, n], "YZ"),

                (X[:, iy, :], Z[:, iy, :],
                 MOs[:, iy, :, n], "XZ"),

                (X[:, :, iz], Y[:, :, iz],
                 MOs[:, :, iz, n], "XY")
            ]

            vmax = max(np.max(np.abs(s[2])) for s in slices)
            levels = np.linspace(-vmax, vmax, 21)

            for col, (A, B, psi, plane) in enumerate(slices):

                axes[row, col].contourf(
                    A, B, psi,
                    levels=levels,
                    cmap="RdBu_r"
                )

                axes[row, col].set_title(
                    f"MO {n+1}: {plane} plane"
                )

                axes[row, col].set_aspect("equal")

        # Save this group of molecular orbitals
        filename = (
            f"{n_sites}_MOs_"
            f"{start+1}-{min(start+orbitals_per_figure, n_sites)}.png"
        )

        fig.savefig(output_dir / filename, dpi=200)
    
#----------------------------------------------------------------------
'''compare energies for different flake sizes'''

def plot_energies(n_values, output_dir):
    '''Save a grid of ordered MO energy spectra for several flake sizes.'''

    nplots = len(n_values)

    ncols = 1 if nplots == 1 else max(2, round(np.sqrt(nplots)))
    nrows = math.ceil(nplots / ncols)

    fig, axes = plt.subplots(nrows, ncols, figsize=(4.5 * ncols, 3.5 * nrows))

    for ax, n in zip(axes.flat, n_values):

        positions, e_val, e_vec = solve_huckel(n)

        ax.scatter(np.arange(n), e_val, s=12)
        ax.axhline(0, color="grey", linestyle="--", linewidth=0.8)
        ax.set_title(f"{n} carbon atoms")
        ax.set_xlabel("Orbital index")
        ax.set_ylabel(r"Energy ($|\beta|$ units)")

    plt.tight_layout()
    plt.savefig(output_dir /f"{len(n_values)}_plots_energies")

#----------------------------------------------------------------------
'''Energy spectrum of flake'''

def plot_energy_spectrum(n_sites, e_val, output_dir):
    '''Save the ordered energy spectrum of one N-site Hückel system.'''

    plt.figure(figsize=(8, 5))
    plt.scatter(
        np.arange(1, len(e_val) + 1),
        e_val,
        s=20
    )

    plt.axhline(0, color="black", linestyle="--", linewidth=1)
    plt.xlabel("Energy level index")
    plt.ylabel(r"Energy $E/|\beta|$")
    plt.title(f"Hückel energy spectrum of a finite graphene flake with {n_sites} sites")
    plt.grid(alpha=0.25)
    plt.tight_layout()
    plt.savefig(output_dir /f'{n_sites}_energy_spectrum')

#----------------------------------------------------------------------
'''HOMO-LUMO separation vs number of atoms'''

def plot_homo_gap(max_sites, output_dir, filename, incomplete = False, complete = False, literature = False, gaps = None):
    '''Separation versus N for even sizes, plot any combination of incomplete, complete and literature results'''

    if max_sites < 6:
        raise ValueError("max_sites must be at least 6.")

    if not (incomplete or complete or literature):
        raise ValueError("Select at least one dataset to plot.")
    
    completed = [6 * m**2 for m in range(1, math.isqrt(max_sites // 6) + 1)]
    completed_set = set(completed)
    incomplete_sizes = [n for n in range(6, max_sites + 1, 2)]

    if gaps is None:
        wanted = (incomplete_sizes if incomplete else []) + (completed if complete else [])
        gaps = calculate_gaps(wanted) if wanted else {}

    fig, ax = plt.subplots(figsize=(7, 5))

    if incomplete:
        xx = [n for n in incomplete_sizes if n in gaps]
        ax.plot(xx, [gaps[n] for n in xx], "o-", color = 'blue', markersize=4, label = 'Incomplete Huckel calculation')

    if complete:
        xx = [n for n in completed if n in gaps]
        ax.plot(xx, [gaps[n] for n in xx], "o-", color = 'orange', markersize=4, label = 'Complete Huckel calculation')

    if literature:
        LITERATURE = {6:4.8, 54:1.64, 96:1.10}
        known=list(LITERATURE)
        ax.scatter(known,[LITERATURE[n] for n in known],marker='x',s=90,zorder=5,label='Jeong & Lee (2024), rounded')
    
    ax.set_xlabel("Number of carbon atoms")
    ax.set_ylabel(r"HOMO–LUMO gap (eV)")
    ax.set_title(f"HOMO–LUMO gap versus graphene flake size")
    ax.grid(alpha=0.3)
    ax.legend()

    fig.tight_layout()
    fig.savefig(output_dir / f'{filename}_gap_vs_size_plot')

#----------------------------------------------------------------------
'''Gap size vs number of carbon atoms, log plot'''

def plot_scaling_test(gaps, completed_shell, output_dir):
    """Fit log(gap) vs log(N), comparing with a reference N^-1/2 slope."""

    shell_N = np.array([n for n in completed_shell], dtype=float)

    if len(shell_N) < 3:
        raise ValueError('At least three nonzero completed shell gaps are needed')
    
    shell_gaps = np.array([gaps[int(n)] for n in shell_N])

    #Followed stack exchange on plotting log plots
    slope, intercept = np.polyfit(np.log(shell_N), np.log(shell_gaps), 1)
    fitted_log = intercept + slope * np.log(shell_N)
    ss_res = np.sum((np.log(shell_gaps) - fitted_log)**2)
    ss_tot = np.sum((np.log(shell_gaps) - np.mean(np.log(shell_gaps)))**2)
    r_squared = 1.0 - ss_res / ss_tot

    xx = np.geomspace(shell_N.min(), shell_N.max(), 200)
    fig, ax = plt.subplots(figsize=(7.5, 5))
    ax.loglog(shell_N, shell_gaps, 'o', label='Computed completed shell gaps')
    ax.loglog(xx, np.exp(intercept) * xx**slope, '--',
              label=fr'Best fit power: $N^{{{slope:.3f}}}$ ($R^2={r_squared:.3f}$)')
    ax.loglog(xx, shell_gaps[0] * (xx / shell_N[0])**(-0.5), ':',
              label=r'$N^{-1/2}$ reference, matched at $N=6$')
    
    ax.set(xlabel='Number of carbon sites, $N$',
           ylabel='HOMO–LUMO gap (eV)', title='Completed shell gap size scaling')
    ax.grid(alpha=0.25, which='both')
    ax.legend()
    fig.tight_layout()
    fig.savefig(output_dir / f'{completed_shell[-1]}_complete_shell_scaling_test.png', dpi=220)

    print(f'Gap scaling: gap ~ N^({slope:.4f}), log-log R^2 = {r_squared:.4f}')

