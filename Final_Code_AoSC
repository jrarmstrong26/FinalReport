def main():
    '''Run the model and output figures, edit parameters below
        - Set PLOT_3D_ORBITALS_ALL = False for large n_sites. 
        - Need to close PyVista to see other plots '''

    #Change variables here
    n_sites = 24
    n_values = [6, 24, 54, 96]   # Choose sites to plot in plot_energy_spectrum
    max_sites = 294              # Used in gap vs size plots - choose number of sites
    orb_index = 24               # Choose individual orbital to plot alone

    #Choose outputing figures
    PLOT_POSITIONS = False
    PLOT_CONTOUR_MO = False        # Prints lot's of plots for big n_sites!
    PLOT_ENERGY_SPECTRUM = False   
    PLOT_ENERGIES = False
    PLOT_3D_ORBITAL = True        # Plot individual orbital - choose orb_index above
    PLOT_3D_ORBITALS_ALL = False   # Most expensive step when set to True, easier to see for smaller n_sites
    PLOT_SCALING_TEST = False

    #For plot_homo_gap, decide what to plot here
    PLOT_HOMO_GAP = False           
    PLOT_INCOMPLETE = True         # plot incomplete shells
    PLOT_COMPLETE = True           # plot complete shells
    PLOT_LITERATURE = False        # plot literature values

    #Variables, don't change for graphene
    alpha, beta = 0.0, -1.0
    a_cc, tolerance = 1.42, 0.1
    l = 1
    beta_eV = 2.40  

    #Used in gap scaling plot
    completed_shell = [6 * m**2 for m in range(1, math.isqrt(max_sites // 6) + 1)] 

    #outputs into folder "Figures"
    output_dir = Path(__file__).resolve().parent / "Figures"
    output_dir.mkdir(parents=True, exist_ok=True)

    positions, e_val, e_vec = solve_huckel(n_sites, alpha, beta, a_cc, tolerance)
    homo, lumo, gap = homo_lumo_gap(e_val)

    print(f'\nHückel results for {n_sites} carbon atoms:')
    print(f'  HOMO energy: {homo / abs(beta):.6f} |β|')
    print(f'  LUMO energy: {lumo / abs(beta):.6f} |β|')
    print(f'  HOMO–LUMO gap: {gap / abs(beta):.6f} |β|')
    print(f'  HOMO–LUMO gap: {gap / abs(beta) * beta_eV:.3f} eV')


    # Only calculate orbitals if need to for plots
    if PLOT_3D_ORBITAL or PLOT_3D_ORBITALS_ALL or PLOT_CONTOUR_MO:
        surface_pos, surface_neg, MOs = orbitals(n_sites, positions, e_vec, l)

    # Calculate only necessary sizes and only once, even if both plots are on.
    needed = set()
    if PLOT_HOMO_GAP:
        if PLOT_INCOMPLETE:
            needed.update(range(6, max_sites + 1, 2))
        if PLOT_COMPLETE:
            needed.update(completed_shell)
    if PLOT_SCALING_TEST:
        needed.update(completed_shell)

    if needed:
        gaps = calculate_gaps(needed, alpha, beta, a_cc, tolerance, beta_eV)
    else:
        gaps = {}
    
    #Plots:
    if PLOT_POSITIONS:
        plot_positions(n_sites, positions, output_dir)
    if PLOT_CONTOUR_MO:
        plot_contour_MO(n_sites, MOs, output_dir)    
    if PLOT_ENERGY_SPECTRUM:
        plot_energy_spectrum(n_sites, e_val, output_dir)
    if PLOT_HOMO_GAP:
        plot_homo_gap(max_sites, output_dir, f'{max_sites}_gap_comparisons', incomplete=PLOT_INCOMPLETE,
                                                                             complete=PLOT_COMPLETE,
                                                                             literature=PLOT_LITERATURE,
                                                                             gaps = gaps)
    if PLOT_SCALING_TEST:
        plot_scaling_test(gaps, completed_shell, output_dir)
    if PLOT_ENERGIES:
        plot_energies(n_values, output_dir)
    if PLOT_3D_ORBITAL:
        plot_3d_orbital(n_sites, orb_index, positions, surface_pos, surface_neg, output_dir)   #Close after use to get other plots. Can move orbital around in pyvista.
    if PLOT_3D_ORBITALS_ALL:
        plot_3d_orbitals_all(n_sites, positions, surface_pos, surface_neg, output_dir)         #Close after use to get other plots. Can move orbitals around in pyvista.

    plt.show()


if __name__ == '__main__':
    main()
