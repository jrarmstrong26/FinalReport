'''compare energies for different flake sizes'''

#I want this section to be a definition, for given n_values, we plot somehting nice. so if its 16 elements, we plot it as a 4x4, if its 5, then two per row three in a column, etc?

def plot_energies(n_values, output_dir):
    '''Save a grid of ordered MO energy spectra for several flake sizes.'''

    nplots = len(n_values)

    ncols = 1 if nplots == 1 else max(2, round(np.sqrt(nplots)))
    nrows = math.ceil(nplots / ncols)

    fig, axes = plt.subplots(nrows, ncols, figsize=(4.5 * ncols, 3.5 * nrows))

    for ax, n in zip(axes.flat, n_values):

        positions, e_val, e_vec = solve_huckel(n)

        ax.scatter(np.arange(n), e_val, s=12)
        ax.axhline(0, color="grey", linestyle="--", linewidth=0.8)
        ax.set_title(f"{n} carbon atoms")
        ax.set_xlabel("Orbital index")
        ax.set_ylabel(r"Energy ($|\beta|$ units)")

    plt.tight_layout()
    plt.savefig(output_dir /f"{n_values}_energies")

#----------------------------------------------------------------------
'''Energy spectrum of flake'''

def plot_energy_spectrum(n_sites, e_val, output_dir):
    '''Save the ordered energy spectrum of one N-site Hückel system.'''

    plt.figure(figsize=(8, 5))
    plt.scatter(
        np.arange(1, len(e_val) + 1),
        e_val,
        s=20
    )

    plt.axhline(0, color="black", linestyle="--", linewidth=1)
    plt.xlabel("Energy level index")
    plt.ylabel(r"Energy $E/|\beta|$")
    plt.title(f"Hückel energy spectrum of a finite graphene flake with {n_sites} sites")
    plt.grid(alpha=0.25)
    plt.tight_layout()
    plt.savefig(output_dir /f'{n_sites}_energy_spectrum')

#----------------------------------------------------------------------
'''HOMO-LUMO separation vs number of atoms'''

def plot_homo_gap(size, output_dir, filename):
    '''Save separation versus N for a sequence of even sizes'''

    atom_counts = []
    gaps = []

    for n_sites in size:

        # Simple closed-shell HOMO/LUMO indexing requires even N
        if n_sites % 2 != 0:
            continue

        positions, e_val, e_vec = solve_huckel(n_sites)

        homo, lumo, gap = homo_lumo_gap(e_val)

        atom_counts.append(n_sites)
        gaps.append(gap)

    fig, ax = plt.subplots(figsize=(7, 5))

    ax.plot(atom_counts, gaps, "o-", markersize=4)

    ax.set_xlabel("Number of carbon atoms")
    ax.set_ylabel(r"HOMO–LUMO gap / $|\beta|$")
    ax.set_title(f"HOMO–LUMO gap versus graphene flake size")
    ax.grid(alpha=0.3)

    fig.tight_layout()
    fig.savefig(output_dir / f'{filename}_gap_vs_size_plot')


####################################################################################################

def main():
    '''Run the model and output figures, edit parameters below
        - Set PLOT_3D_ORBITALS_ALL = False for large n_sites. 
        - Need to close PyVista to see other plots '''

    #Change variables here
    n_sites = 24
    n_values = [6, 24, 54, 96]   # Choose sites to plot in plot_energy_spectrum
    shells = 7                   # Used in gap vs size plots - choose number of completed shells
    max_sites = 294              # Used in gap vs size plots - choose number of sites
    orb_index = 20               # Choose individual orbital to plot alone

    #Choose outputing figures
    PLOT_POSITIONS = True
    PLOT_CONTOUR_MO = True        # Prints lot's of plots for big n_sites!
    PLOT_ENERGY_SPECTRUM = True   
    PLOT_HOMO_GAP = True
    PLOT_ENERGIES = True
    PLOT_3D_ORBITAL = True        # Plot individual orbital - choose orb_index above
    PLOT_3D_ORBITALS_ALL = True   # Most expensive step when set to True, easier to see for smaller n_sites

    #Variables, don't change for graphene
    alpha, beta = 0.0, -1.0
    a_cc, tolerance = 1.42, 0.1
    l = 1

    #Used in gap vs size plots
    completed_shell = [6 * m**2 for m in range(1, shells + 1)]
    size = range(6, max_sites + 1, 2)

    #outputs into folder "Figures"
    output_dir = Path(__file__).resolve().parent / "Figures"
    output_dir.mkdir(parents=True, exist_ok=True)

    
    positions, e_val, e_vec = solve_huckel(n_sites, alpha, beta, a_cc, tolerance)
    surface_pos, surface_neg, MOs = orbitals(n_sites, positions, e_vec, l)
    homo, lumo, gap = homo_lumo_gap(e_val)

    
    beta_eV = 2.40  
    gap_normalised = gap / abs(beta)
    gap_eV = gap_normalised * beta_eV

    print(f"\nHückel results for {n_sites} carbon atoms:")
    print(f"  HOMO energy:       {homo / abs(beta):.6f} |β|")
    print(f"  LUMO energy:       {lumo / abs(beta):.6f} |β|")
    print(f"  HOMO–LUMO gap:     {gap_normalised:.6f} |β|")
    print(f"  Using |β| = {beta_eV:.2f} eV:")
    print(f"  HOMO–LUMO gap:     {gap_eV:.3f} eV")


    #Plots:
    if PLOT_POSITIONS:
        plot_positions(n_sites, positions, output_dir)
    if PLOT_CONTOUR_MO:
        plot_contour_MO(n_sites, MOs, output_dir)    
    if PLOT_ENERGY_SPECTRUM:
        plot_energy_spectrum(n_sites, e_val, output_dir)
    if PLOT_HOMO_GAP:
        plot_homo_gap(size, output_dir, f'{max_sites}_sites')
        plot_homo_gap(completed_shell, output_dir, f'{shells}_shells')
    if PLOT_ENERGIES:
        plot_energies(n_values, output_dir)
    if PLOT_3D_ORBITAL:
        plot_3d_orbital(n_sites, orb_index, positions, surface_pos, surface_neg, output_dir)   #Close after use to get other plots. Can move orbital around in pyvista.
    if PLOT_3D_ORBITALS_ALL:
        plot_3d_orbitals_all(n_sites, positions, surface_pos, surface_neg, output_dir)         #Close after use to get other plots. Can move orbitals around in pyvista.

    plt.show()


if __name__ == '__main__':
    main()
